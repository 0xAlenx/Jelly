PORT=8787
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/jellyai
JELLY_JWT_SECRET=replace-with-a-long-random-secret
JELLY_ACCESS_KEY_PEPPER=replace-with-a-long-random-pepper
JELLY_CONFIG_ENCRYPTION_KEY=replace-with-a-separate-long-random-encryption-key
JELLY_ADMIN_USERNAME=admin
JELLY_ADMIN_PASSWORD=replace-on-first-deploy
JELLY_MODEL_BASE_URL=https://your-model-gateway.example.com/v1
JELLY_MODEL_API_KEY=
JELLY_DEFAULT_MODEL=
JELLY_ACCESS_TOKEN_TTL_SECONDS=900
JELLY_REFRESH_TOKEN_TTL_SECONDS=2592000
JELLY_MINIMUM_RESERVATION_CREDITS=5
JELLY_RESERVATION_OUTPUT_TOKENS=2048
JELLY_LOGISTICS_QUOTE_TIMEOUT_SECONDS=45
JELLY_CORS_ORIGINS=https://app.jellyai.cloud

